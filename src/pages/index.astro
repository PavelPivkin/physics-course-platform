---
import BaseLayout from "../layouts/BaseLayout.astro";

const examDate = "2027-06-10T10:00:00+03:00";
const pillars = [
  {
    index: "01",
    title: "Открытая физика",
    text: "Теория, интерактивные презентации и задачи по материалам ФИПИ — открыто и последовательно.",
    tag: "Учиться",
  },
  {
    index: "02",
    title: "Живой canvas",
    text: "Пространство урока: силы, тела, графики и формулы на общей доске с преподавателем и учениками.",
    tag: "Исследовать",
  },
  {
    index: "03",
    title: "Интенсив",
    text: "Закрытая программа подготовки: занятия, домашние работы, обратная связь и видимый прогресс.",
    tag: "Подготовиться",
  },
];
---

<BaseLayout
  title="Физика — понять и сдать ОГЭ"
  description="Платформа подготовки к ОГЭ по физике: открытая теория, интерактивная доска и интенсив с обратной связью."
>
  <header class="site-header">
    <a class="brand" href="#top" aria-label="Физика — на главную">
      <svg viewBox="0 0 42 42" aria-hidden="true">
        <circle cx="21" cy="21" r="3.5"></circle>
        <ellipse cx="21" cy="21" rx="18" ry="7.5"></ellipse>
        <ellipse cx="21" cy="21" rx="18" ry="7.5" transform="rotate(60 21 21)"></ellipse>
        <ellipse cx="21" cy="21" rx="18" ry="7.5" transform="rotate(120 21 21)"></ellipse>
      </svg>
      <span>Физика</span>
    </a>

    <nav aria-label="Основная навигация">
      <a href="#platform">Платформа</a>
      <a href="#principle">Подход</a>
    </nav>

    <a class="btn btn-sm launch-button" href="#platform">Смотреть проект</a>
  </header>

  <main id="top">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-grid" aria-hidden="true"></div>

      <div class="hero-copy">
        <p class="eyebrow">ОГЭ по физике · 2027</p>
        <h1 id="hero-title">Не заучивать.<br /><span>Понимать.</span></h1>
        <p class="hero-lead">
          Платформа, где физика становится видимой: от короткого объяснения
          до общей доски и системной подготовки к экзамену.
        </p>
        <div class="hero-actions">
          <a class="btn primary-action" href="#platform">Узнать, что внутри</a>
          <a class="text-link" href="#principle">Как мы объясняем <span>→</span></a>
        </div>
      </div>

      <div class="countdown-shell" data-countdown data-target={examDate}>
        <div class="orbit-visual" aria-hidden="true">
          <svg viewBox="0 0 520 520">
            <circle class="orbit orbit-one" cx="260" cy="260" r="205"></circle>
            <circle class="orbit orbit-two" cx="260" cy="260" r="143"></circle>
            <path class="trajectory" d="M 83 345 Q 225 48 438 155"></path>
            <circle class="body-dot" cx="83" cy="345" r="8"></circle>
            <circle class="accent-dot" cx="438" cy="155" r="9"></circle>
            <path class="vector" d="M260 260 L393 210"></path>
            <path class="vector-head" d="M393 210 L373 205 M393 210 L382 228"></path>
            <text x="405" y="205">F</text>
          </svg>
        </div>

        <div class="countdown-content">
          <p>До ОГЭ по физике</p>
          <div class="countdown-value" data-days>—</div>
          <div class="countdown-unit">дней</div>
          <div class="countdown-detail">
            <span><strong data-hours>—</strong> часов</span>
            <span><strong data-minutes>—</strong> минут</span>
          </div>
          <p class="date-note">10 июня 2027 · дата по проекту расписания</p>
        </div>
      </div>
    </section>

    <section class="platform-section" id="platform" aria-labelledby="platform-title">
      <div class="section-heading">
        <p class="eyebrow">Единая среда подготовки</p>
        <h2 id="platform-title">Три части одной системы</h2>
        <div class="heading-line"></div>
      </div>

      <div class="pillar-list">
        {pillars.map((pillar) => (
          <article class="pillar">
            <div class="pillar-index">{pillar.index}</div>
            <div class="pillar-copy">
              <h3>{pillar.title}</h3>
              <p>{pillar.text}</p>
            </div>
            <span class="pillar-tag">{pillar.tag}</span>
          </article>
        ))}
      </div>
    </section>

    <section class="principle-section" id="principle" aria-labelledby="principle-title">
      <div class="principle-diagram" aria-hidden="true">
        <svg viewBox="0 0 640 360">
          <defs>
            <marker id="arrow" markerWidth="10" markerHeight="10" refX="8" refY="5" orient="auto">
              <path d="M0,0 L10,5 L0,10 Z"></path>
            </marker>
          </defs>
          <line x1="76" y1="285" x2="566" y2="285" class="axis"></line>
          <line x1="122" y1="318" x2="122" y2="58" class="axis"></line>
          <path d="M122 267 C220 255 260 210 325 176 S455 104 548 82" class="graph"></path>
          <line x1="325" y1="176" x2="325" y2="285" class="projection"></line>
          <line x1="325" y1="176" x2="482" y2="120" class="force-arrow" marker-end="url(#arrow)"></line>
          <circle cx="325" cy="176" r="10" class="point"></circle>
          <text x="493" y="113">результат</text>
        </svg>
      </div>

      <div class="principle-copy">
        <p class="eyebrow">Принцип проекта</p>
        <h2 id="principle-title">Сначала модель.<br />Потом формула.</h2>
        <p>
          Мы показываем, что происходит с телом, графиком или полем, и только
          после этого переводим наблюдение на язык математики.
        </p>
        <div class="formula" aria-label="Сила равна произведению массы на ускорение">
          <span class="formula-accent">F</span> = m<span class="formula-blue">a</span>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <a class="brand footer-brand" href="#top">Физика</a>
    <p>Проект в разработке · ОГЭ 2027</p>
  </footer>

  <script>
    const root = document.querySelector<HTMLElement>("[data-countdown]");

    if (root) {
      const target = new Date(root.dataset.target ?? "").getTime();
      const daysNode = root.querySelector<HTMLElement>("[data-days]");
      const hoursNode = root.querySelector<HTMLElement>("[data-hours]");
      const minutesNode = root.querySelector<HTMLElement>("[data-minutes]");

      const renderCountdown = () => {
        const remaining = Math.max(0, target - Date.now());
        const totalMinutes = Math.floor(remaining / 60_000);
        const days = Math.floor(totalMinutes / 1_440);
        const hours = Math.floor((totalMinutes % 1_440) / 60);
        const minutes = totalMinutes % 60;

        if (daysNode) daysNode.textContent = new Intl.NumberFormat("ru-RU").format(days);
        if (hoursNode) hoursNode.textContent = String(hours).padStart(2, "0");
        if (minutesNode) minutesNode.textContent = String(minutes).padStart(2, "0");
      };

      renderCountdown();
      window.setInterval(renderCountdown, 30_000);
    }
  </script>
</BaseLayout>
