---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { topics } from "../data/catalog";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const url = (path = "") => `${base}${path}`;
const examDate = "2027-06-10T10:00:00+03:00";
---

<BaseLayout
  title="Физика — понимать, исследовать, решать"
  description="Открытая теория, тренажёры, физическая доска и системная подготовка к ОГЭ и ЕГЭ."
>
  <SiteHeader active="home" />
  <main>
    <section class="portal-hero page-shell">
      <div class="hero-copy">
        <p class="eyebrow">Физика · 7–11 класс · ОГЭ и ЕГЭ</p>
        <h1>Сначала <span>понимаем.</span><br />Потом считаем.</h1>
        <p class="hero-lead">
          Одна карта физики: теория объясняет модель, задачи проверяют навык,
          симуляции дают поэкспериментировать, а курс собирает всё в маршрут.
        </p>
        <div class="hero-actions">
          <a class="primary-button" href={url("learn/")}>Выбрать тему <span>→</span></a>
          <a class="secondary-button" href={url("practice/term-sorter/")}>Сыграть в тренажёр</a>
        </div>
      </div>

      <div class="hero-side">
        <section class="exam-countdown" data-countdown data-target={examDate} aria-label="Обратный отсчёт до ОГЭ по физике">
          <div class="countdown-main">
            <p>До ОГЭ по физике</p>
            <div class="countdown-number"><strong data-days>—</strong><span>дней</span></div>
            <small>10 июня 2027 · предварительная дата</small>
          </div>
          <div class="countdown-details">
            <div><strong data-hours>—</strong><span>часов</span></div>
            <div><strong data-minutes>—</strong><span>минут</span></div>
          </div>
        </section>

        <div class="route-map" aria-label="Учебный маршрут">
          <div class="route-start"><span>01</span><strong>Тема</strong><small>о чём говорим</small></div>
          <div class="route-line"></div>
          <div class="route-node"><span>02</span><strong>Модель</strong><small>что происходит</small></div>
          <div class="route-line"></div>
          <div class="route-node accent"><span>03</span><strong>Навык</strong><small>что умею</small></div>
          <div class="route-line"></div>
          <div class="route-node"><span>04</span><strong>Экзамен</strong><small>как проверяют</small></div>
        </div>
      </div>
    </section>

    <section class="home-section page-shell">
      <div class="section-heading split-heading">
        <div>
          <p class="eyebrow">Начать с содержания</p>
          <h2>Одна физика — разная глубина</h2>
        </div>
        <div class="track-switch" aria-label="Цель обучения">
          <button class="is-active" type="button">База</button>
          <button type="button">ОГЭ</button>
          <button type="button">ЕГЭ</button>
        </div>
      </div>

      <div class="topic-preview-grid">
        {topics.slice(0, 3).map((topic, index) => (
          <a class="topic-card" href={url(`learn/${topic.slug}/`)}>
            <div class="topic-card-top">
              <span>0{index + 1}</span>
              <div class="topic-symbol">{topic.accent}</div>
            </div>
            <p>{topic.eyebrow}</p>
            <h3>{topic.title}</h3>
            <div class="topic-meta">{topic.tracks.join(" · ")}</div>
            <span class="card-arrow">Открыть тему →</span>
          </a>
        ))}
      </div>
      <a class="text-arrow" href={url("learn/")}>Все темы →</a>
    </section>

    <section class="practice-banner page-shell">
      <div>
        <p class="eyebrow">Решать · тренажёры</p>
        <h2>Термин или величина?</h2>
        <p>Быстрая игра по заданию №1 ОГЭ: 45 секунд, шесть категорий и разбор каждой ошибки.</p>
      </div>
      <div class="practice-banner-score" aria-hidden="true"><strong>45</strong><span>секунд</span></div>
      <a class="primary-button" href={url("practice/term-sorter/")}>Начать игру <span>→</span></a>
    </section>
  </main>

  <footer class="app-footer page-shell">
    <span>Физика с Пивкиным</span>
    <span>Прототип структуры платформы · 2026</span>
  </footer>

  <script>
    const countdown = document.querySelector<HTMLElement>("[data-countdown]");

    if (countdown) {
      const target = new Date(countdown.dataset.target ?? "").getTime();
      const daysNode = countdown.querySelector<HTMLElement>("[data-days]");
      const hoursNode = countdown.querySelector<HTMLElement>("[data-hours]");
      const minutesNode = countdown.querySelector<HTMLElement>("[data-minutes]");

      const renderCountdown = () => {
        const remaining = Math.max(0, target - Date.now());
        const totalMinutes = Math.floor(remaining / 60_000);
        const days = Math.floor(totalMinutes / 1_440);
        const hours = Math.floor((totalMinutes % 1_440) / 60);
        const minutes = totalMinutes % 60;

        if (daysNode) daysNode.textContent = new Intl.NumberFormat("ru-RU").format(days);
        if (hoursNode) hoursNode.textContent = String(hours).padStart(2, "0");
        if (minutesNode) minutesNode.textContent = String(minutes).padStart(2, "0");
      };

      renderCountdown();
      window.setInterval(renderCountdown, 30_000);
    }
  </script>
</BaseLayout>
