---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import QuestionTrainer from "../../components/QuestionTrainer.astro";
import { foundationQuestions } from "../../data/ogeModules";
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<BaseLayout title="Математика и СИ — тренажёр" description="Тренажёр по векторам, формулам, степеням и переводам единиц.">
  <SiteHeader active="practice" />
  <main class="trainer-page page-shell">
    <div class="breadcrumbs"><a href={`${base}practice/`}>Тренажёры</a><span>/</span><span>Стартовый модуль</span></div>
    <QuestionTrainer
      trainerId="foundation"
      eyebrow="Математическая подготовка · СИ"
      title="Собери расчёт"
      description="Короткий диагностический раунд: векторы, выражение формул, степени десяти, скорость, площадь и энергия. Результат по навыкам сохраняется на этом устройстве."
      questions={foundationQuestions}
    />
  </main>
</BaseLayout>
