---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
const faviconPath = `${base.replace(/\/$/, "")}/favicon.svg`;
---

<!doctype html>
<html lang="ru" data-theme="physics-dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0B1E33" />
    <link rel="icon" href={faviconPath} type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
