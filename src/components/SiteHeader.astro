---
interface Props {
  active?: "home" | "learn" | "practice" | "board" | "intensive";
}

const { active = "home" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const url = (path = "") => `${base}${path}`;
---

<header class="app-header">
  <a class="brand" href={url()} aria-label="Физика — на главную">
    <svg viewBox="0 0 42 42" aria-hidden="true">
      <circle cx="21" cy="21" r="3.5"></circle>
      <ellipse cx="21" cy="21" rx="18" ry="7.5"></ellipse>
      <ellipse cx="21" cy="21" rx="18" ry="7.5" transform="rotate(60 21 21)"></ellipse>
      <ellipse cx="21" cy="21" rx="18" ry="7.5" transform="rotate(120 21 21)"></ellipse>
    </svg>
    <span>Физика</span>
  </a>

  <nav aria-label="Основная навигация">
    <a class:list={[{ active: active === "learn" }]} href={url("learn/")}>Учиться</a>
    <a class:list={[{ active: active === "practice" }]} href={url("practice/")}>Решать</a>
    <a class:list={[{ active: active === "board" }]} href={url("board/")}>Доска</a>
    <a class:list={[{ active: active === "intensive" }]} href={url("intensive/")}>Интенсив</a>
  </nav>

  <div class="header-actions">
    <span class="prototype-label">Прототип</span>
    <button
      class="theme-toggle"
      type="button"
      data-theme-toggle
      aria-label="Включить светлую тему"
      aria-pressed="false"
      title="Включить светлую тему"
    >
      <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="3.5"></circle>
        <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"></path>
      </svg>
      <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20 15.2A8.4 8.4 0 0 1 8.8 4a8.4 8.4 0 1 0 11.2 11.2Z"></path>
      </svg>
    </button>
  </div>
</header>
