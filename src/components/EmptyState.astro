---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "./SiteHeader.astro";

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  active?: "home" | "learn" | "practice" | "board" | "intensive";
  backHref?: string;
  backLabel?: string;
}

const {
  eyebrow,
  title,
  description,
  active = "home",
  backHref = "",
  backLabel = "На главную",
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<BaseLayout title={`${title} — Физика`} description={description}>
  <SiteHeader active={active} />
  <main class="empty-page page-shell">
    <div class="empty-orbit" aria-hidden="true">
      <span></span><span></span><i></i>
    </div>
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="empty-description">{description}</p>
    <div class="status-chip"><span></span> Раздел связан, контент появится позже</div>
    <a class="text-arrow" href={`${base}${backHref}`}>← {backLabel}</a>
  </main>
</BaseLayout>
